# Private single-Linux-host template. No builds, public ingress, or HA claim.
# Provision secrets separately; never place secret values here.
# Supply release tags/digests from your registry. Latest/local/dev tags are rejected.
DELIVERYPILOT_STACK=deliverypilot-server
DELIVERYPILOT_ENVIRONMENT=Production
DELIVERYPILOT_SECRETS_DIR=/etc/deliverypilot/secrets
DELIVERYPILOT_SETUP_IMAGE=registry.example/deliverypilot/setup:REPLACE_WITH_RELEASE
DELIVERYPILOT_GATEWAY_IMAGE=registry.example/deliverypilot/gateway:REPLACE_WITH_RELEASE
DELIVERYPILOT_GATEWAY_PORT=19090
DELIVERYPILOT_GATEWAY_PUBLIC_HOST=REPLACE_WITH_PUBLIC_API_HOSTNAME
DELIVERYPILOT_HTTP_SUBNET=172.31.250.0/24
DELIVERYPILOT_GATEWAY_IP=172.31.250.10
DELIVERYPILOT_INGRESS_PROXY_IP=REPLACE_WITH_OBSERVED_INGRESS_PEER_IPV4
DELIVERYPILOT_IDENTITY_API_IMAGE=registry.example/deliverypilot/identity-api:REPLACE_WITH_RELEASE
DELIVERYPILOT_IDENTITY_WORKER_IMAGE=registry.example/deliverypilot/identity-worker:REPLACE_WITH_RELEASE
DELIVERYPILOT_IDENTITY_MIGRATION_IMAGE=registry.example/deliverypilot/identity-migration:REPLACE_WITH_RELEASE
DELIVERYPILOT_NOTIFICATION_API_IMAGE=registry.example/deliverypilot/notification-api:REPLACE_WITH_RELEASE
DELIVERYPILOT_NOTIFICATION_WORKER_IMAGE=registry.example/deliverypilot/notification-worker:REPLACE_WITH_RELEASE
DELIVERYPILOT_NOTIFICATION_MIGRATION_IMAGE=registry.example/deliverypilot/notification-migration:REPLACE_WITH_RELEASE
DELIVERYPILOT_DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0@sha256:de4fe90a98845d75910b9769662465c84de1a934665c431279d1382b2bddc02b
DELIVERYPILOT_DOTNET_RUNTIME_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0@sha256:de0ee358cdd672f7017a003bed21e9ac9ed48a27c922a59b18175b6e82fa7fee
DELIVERYPILOT_POSTGRES_IMAGE=postgres:18-bookworm@sha256:bbf83594798e144bff365a9c191c5d779f181fb3135902064ab8ff11918020fc
DELIVERYPILOT_RABBITMQ_IMAGE=rabbitmq:4.3.6-management@sha256:54cb013d76cd1fd6c0a0708f34062ad61c452bb6f016b434c6c33f1a765d2b58
DELIVERYPILOT_MAILPIT_IMAGE=axllent/mailpit:v1.27@sha256:e22dce5b36f93c77082e204a3942fb6b283b7896e057458400a4c88344c3df68
# Backend ports below are local development settings; server APIs publish no ports.
DELIVERYPILOT_IDENTITY_API_PORT=19091
DELIVERYPILOT_NOTIFICATION_API_PORT=19092
# Developer-only values below are unused by the image-only module definitions.
DELIVERYPILOT_IDENTITY_POSTGRES_PORT=25431
DELIVERYPILOT_NOTIFICATION_POSTGRES_PORT=25432
DELIVERYPILOT_RABBITMQ_AMQP_PORT=25672
DELIVERYPILOT_RABBITMQ_MANAGEMENT_PORT=25673
DELIVERYPILOT_MAILPIT_SMTP_PORT=21025
DELIVERYPILOT_MAILPIT_HTTP_PORT=28025
DELIVERYPILOT_FRONTEND_ORIGIN=https://REPLACE_WITH_FRONTEND_ORIGIN
DELIVERYPILOT_JWT_ISSUER=DeliveryPilot.Identity
DELIVERYPILOT_JWT_AUDIENCE=DeliveryPilot
# Operator-provided TLS RabbitMQ cluster, credentials, permissions and topology.
# The bundled single-node broker is local-only. Certificate must be trusted.
DELIVERYPILOT_MESSAGING_HOST=REPLACE_WITH_TLS_BROKER_HOST
DELIVERYPILOT_MESSAGING_PORT=5671
DELIVERYPILOT_MESSAGING_VIRTUAL_HOST=/deliverypilot-server
DELIVERYPILOT_MESSAGING_DEVELOPMENT=false
DELIVERYPILOT_MESSAGING_USE_TLS=true
DELIVERYPILOT_MESSAGING_QUORUM_SIZE=3
DELIVERYPILOT_EMAIL_MODE=Disabled
DELIVERYPILOT_EMAIL_SENDER=DeliveryPilot <auth@example.test>
DELIVERYPILOT_EMAIL_DOMAIN_VERIFIED=false
DELIVERYPILOT_GRAFANA_PORT=23000
DELIVERYPILOT_OTLP_PORT=24317
DELIVERYPILOT_OTLP_HTTP_PORT=24318
DELIVERYPILOT_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.123.0
DELIVERYPILOT_GRAFANA_IMAGE=grafana/grafana:11.6.0
DELIVERYPILOT_LOKI_IMAGE=grafana/loki:3.4.2
DELIVERYPILOT_TEMPO_IMAGE=grafana/tempo:2.7.2
DELIVERYPILOT_PROMETHEUS_IMAGE=prom/prometheus:v3.2.1
