# Literal, unquoted KEY=value only. No passwords, keys, or shell expansion here.
# scripts/deliverypilot init copies this file; generated secrets are separate and stable.
DELIVERYPILOT_STACK=deliverypilot-local
DELIVERYPILOT_ENVIRONMENT=Development
DELIVERYPILOT_SECRETS_DIR=deploy/secrets/deliverypilot-local
DELIVERYPILOT_SETUP_IMAGE=deliverypilot-setup:local
# Optional existing Buildx builder for local builds (see docs/Deploy.md).
# DELIVERYPILOT_BUILD_BUILDER=deliverypilot-local-build
DELIVERYPILOT_GATEWAY_IMAGE=deliverypilot-gateway:local
DELIVERYPILOT_GATEWAY_PORT=19090
DELIVERYPILOT_GATEWAY_PUBLIC_HOST=localhost
DELIVERYPILOT_HTTP_SUBNET=172.31.250.0/24
DELIVERYPILOT_GATEWAY_IP=172.31.250.10
# Docker bridge peer used by a host-based ingress. Verify the observed peer for other topologies.
DELIVERYPILOT_INGRESS_PROXY_IP=172.31.250.1
DELIVERYPILOT_IDENTITY_API_IMAGE=deliverypilot-identity-api:local
DELIVERYPILOT_IDENTITY_WORKER_IMAGE=deliverypilot-identity-worker:local
DELIVERYPILOT_IDENTITY_MIGRATION_IMAGE=deliverypilot-identity-migration:local
DELIVERYPILOT_NOTIFICATION_API_IMAGE=deliverypilot-notification-api:local
DELIVERYPILOT_NOTIFICATION_WORKER_IMAGE=deliverypilot-notification-worker:local
DELIVERYPILOT_NOTIFICATION_MIGRATION_IMAGE=deliverypilot-notification-migration:local
DELIVERYPILOT_DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0@sha256:de4fe90a98845d75910b9769662465c84de1a934665c431279d1382b2bddc02b
DELIVERYPILOT_DOTNET_RUNTIME_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0@sha256:de0ee358cdd672f7017a003bed21e9ac9ed48a27c922a59b18175b6e82fa7fee
DELIVERYPILOT_POSTGRES_IMAGE=postgres:18-bookworm@sha256:bbf83594798e144bff365a9c191c5d779f181fb3135902064ab8ff11918020fc
DELIVERYPILOT_RABBITMQ_IMAGE=rabbitmq:4.3.6-management@sha256:54cb013d76cd1fd6c0a0708f34062ad61c452bb6f016b434c6c33f1a765d2b58
DELIVERYPILOT_MAILPIT_IMAGE=axllent/mailpit:v1.27@sha256:e22dce5b36f93c77082e204a3942fb6b283b7896e057458400a4c88344c3df68
DELIVERYPILOT_IDENTITY_API_PORT=19091
DELIVERYPILOT_NOTIFICATION_API_PORT=19092
DELIVERYPILOT_IDENTITY_POSTGRES_PORT=25431
DELIVERYPILOT_NOTIFICATION_POSTGRES_PORT=25432
DELIVERYPILOT_RABBITMQ_AMQP_PORT=25672
DELIVERYPILOT_RABBITMQ_MANAGEMENT_PORT=25673
DELIVERYPILOT_MAILPIT_SMTP_PORT=21025
DELIVERYPILOT_MAILPIT_HTTP_PORT=28025
DELIVERYPILOT_FRONTEND_ORIGIN=http://127.0.0.1:5173
DELIVERYPILOT_JWT_ISSUER=DeliveryPilot.Identity
DELIVERYPILOT_JWT_AUDIENCE=DeliveryPilot
DELIVERYPILOT_MESSAGING_HOST=rabbitmq
DELIVERYPILOT_MESSAGING_PORT=5672
DELIVERYPILOT_MESSAGING_VIRTUAL_HOST=/deliverypilot-local
DELIVERYPILOT_MESSAGING_DEVELOPMENT=true
DELIVERYPILOT_MESSAGING_USE_TLS=false
DELIVERYPILOT_MESSAGING_QUORUM_SIZE=1
DELIVERYPILOT_EMAIL_MODE=Mailpit
DELIVERYPILOT_EMAIL_SENDER=DeliveryPilot <auth@example.test>
DELIVERYPILOT_EMAIL_DOMAIN_VERIFIED=false
DELIVERYPILOT_GRAFANA_PORT=23000
DELIVERYPILOT_OTLP_PORT=24317
DELIVERYPILOT_OTLP_HTTP_PORT=24318
DELIVERYPILOT_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.123.0
DELIVERYPILOT_GRAFANA_IMAGE=grafana/grafana:11.6.0
DELIVERYPILOT_LOKI_IMAGE=grafana/loki:3.4.2
DELIVERYPILOT_TEMPO_IMAGE=grafana/tempo:2.7.2
DELIVERYPILOT_PROMETHEUS_IMAGE=prom/prometheus:v3.2.1
DELIVERYPILOT_PROJECTS_API_IMAGE=deliverypilot-projects-api:local
DELIVERYPILOT_PROJECTS_WORKER_IMAGE=deliverypilot-projects-worker:local
DELIVERYPILOT_PROJECTS_MIGRATION_IMAGE=deliverypilot-projects-migration:local
